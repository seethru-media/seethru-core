---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Attribution from '../../components/Attribution.astro';
import { loadAllFuels } from '@seethru/fuel-loader';
import { generatePostPaths, getPostBySlug } from '@seethru/fuel-loader/src/astro-integration';
import { fuelConfig } from '../../fuel.config';

// Load all content and generate static paths
export async function getStaticPaths() {
  const result = await loadAllFuels(fuelConfig);

  // Log errors for debugging
  if (result.totalErrors > 0) {
    console.warn(`⚠️  Loaded content with ${result.totalErrors} errors`);
    result.fuels.forEach(fuel => {
      fuel.errors.forEach(error => {
        console.error(`  ${error.type}: ${error.filePath} - ${error.message}`);
      });
    });
  }

  console.log(`✅ Loaded ${result.allPosts.length} posts from ${result.fuels.length} fuel source(s)`);

  return generatePostPaths(result);
}

const { post } = Astro.props;

// Format date for attribution
const postDate = new Date(post.publishedAt);
---

<BaseLayout title={post.title}>
  <article>
    <header style="margin-bottom: var(--space-6);">
      <h1 style="font-size: 2rem; line-height: 1.2; margin-bottom: var(--space-2);">
        {post.title}
      </h1>
      {
        post.subtitle && (
          <p style="font-size: 1.25rem; color: var(--color-text-muted);">{post.subtitle}</p>
        )
      }
      <div style="margin-top: var(--space-4);">
        <Attribution
          author={post.authorName}
          authorUrl="/"
          date={postDate}
          source={post.source}
          aiDisclosure={post.aiDisclosure}
        />
      </div>
    </header>

    <div class="content" set:html={post.content} />

    <footer
      style="margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px solid var(--color-border, #ddd);"
    >
      <a href="/" style="color: var(--color-primary);">← Back to Daily Brief</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .content {
    line-height: 1.7;
  }

  .content p {
    margin-bottom: 1rem;
  }

  .content ul,
  .content ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .content li {
    margin-bottom: 0.5rem;
  }
</style>
